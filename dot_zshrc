# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

# Inicializar Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Cargar plugins manualmente si existen
for plugin in zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search; do
  plugin_path="${ZSH_CUSTOM:-$ZSH/custom}/plugins/$plugin/$plugin.zsh"
  [[ -f "$plugin_path" ]] && source "$plugin_path"
done

autoload -Uz compinit
compinit

# Mostrar entorno virtual actual
function virtualenv_info {
  [[ -n "$VIRTUAL_ENV" ]] && echo "($(basename "$VIRTUAL_ENV"))"
}
PROMPT='%F{green}%n @%m%f %F{blue}%~%f $(virtualenv_info) %# '

# Alias útiles para desarrollo
alias px='proxychains4'
alias ls='eza --icons --group-directories-first'
alias ll='ls -lah'
alias cat="bat --paging=never --style=plain --theme=auto"
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias ..='cd ..'
alias ...='cd ../..'
alias venv='python -m venv venv && source venv/bin/activate'
alias py='ipython'
alias serve='python3 -m http.server'
alias run='python main.py'
alias r='python'
alias pipu='pip install --upgrade pip'
alias pipr='pip install -r requirements.txt'
alias pinit='python -m venv venv && source venv/bin/activate && pip install -r requirements.txt'

# Función para copiar el contenido de un archivo al portapapeles usando wl-copy
cpf() {
  if [[ -f "$1" ]]; then
    wl-copy < "$1"
    echo "📋 Archivo '$1' copiado al portapapeles con wl-copy"
  else
    echo "❌ Archivo no encontrado: $1"
  fi
}

# --- Herramientas de Productividad ---
